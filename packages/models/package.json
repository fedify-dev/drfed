    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./uuid": {
      "types": "./dist/uuid.d.mts",
      "default": "./dist/uuid.mjs"
    },
    "./login": {
      "types": "./dist/login.d.mts",
      "default": "./dist/login.mjs"
    },
    "./resource": {
      "types": "./dist/resource.d.mts",
      "default": "./dist/resource.mjs"
    },
    "./document": {
      "types": "./dist/document.d.mts",
      "default": "./dist/document.mjs"
    },
    "./slug": {
      "types": "./dist/slug.d.mts",
      "default": "./dist/slug.mjs"
    },
    "./key": {
      "types": "./dist/key.d.mts",
      "default": "./dist/key.mjs"
    },
    "./activity-delivery": {
      "types": "./dist/activity-delivery.d.mts",
      "default": "./dist/activity-delivery.mjs"
    },
    "./instance": {
      "types": "./dist/instance.d.mts",
      "default": "./dist/instance.mjs"
    },
    "./text": {
      "types": "./dist/text.d.mts",
      "default": "./dist/text.mjs"
    },
    "./migration-manifest": {
      "types": "./dist/migration-manifest.d.mts",
      "default": "./dist/migration-manifest.mjs"
    },
    "./migration-state": {
      "types": "./dist/migration-state.d.mts",
      "default": "./dist/migration-state.mjs"
    },
    "./migration-session": {
      "types": "./dist/migration-session.d.mts",
      "default": "./dist/migration-session.mjs"
    },
    "./pglite-store": {
      "types": "./dist/pglite-store.d.mts",
      "default": "./dist/pglite-store.mjs"
    },
    "./pglite-preparation": {
      "types": "./dist/pglite-preparation.d.mts",
      "default": "./dist/pglite-preparation.mjs"
    },
    "./resource-revision": {
      "types": "./dist/resource-revision.d.mts",
      "default": "./dist/resource-revision.mjs"
    }
  },
  "files": [
    "dist/",
    "drizzle/",
    "README.md"
  ],
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/db.ts",
      "src/email.ts",
      "src/migrate.ts",
      "src/relations.ts",
      "src/schema.ts",
      "src/uuid.ts",
      "src/login.ts",
      "src/resource.ts",
      "src/document.ts",
      "src/slug.ts",
      "src/key.ts",
      "src/activity-delivery.ts",
      "src/instance.ts",
      "src/text.ts",
      "src/migration-manifest.ts",
      "src/migration-state.ts",
      "src/migration-session.ts",
      "src/pglite-store.ts",
      "src/pglite-preparation.ts",
      "src/resource-revision.ts"
    ],
    "dts": {
      "sourcemap": true,
      "tsconfig": "../../tsconfig.models.json"
    },
    "sourcemap": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test"
  },
  "devDependencies": {
    "@logtape/testing-node": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-beta.22",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@fedify/vocab": "catalog:",
    "@fedify/vocab-runtime": "catalog:",
    "@logtape/logtape": "catalog:",
    "@types/pg": "8.20.0",
    "drizzle-orm": "catalog:",
    "fs-native-extensions": "1.5.1",
    "pg": "catalog:",
    "postgres": "catalog:",
    "uuid": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fedify-dev/drfed.git",
    "directory": "packages/models"
  },
  "publishConfig": {
    "access": "public"
  }
