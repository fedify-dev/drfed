    }
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./db": {
      "types": "./dist/db.d.mts",
      "default": "./dist/db.mjs"
    },
    "./email": {
      "types": "./dist/email.d.mts",
