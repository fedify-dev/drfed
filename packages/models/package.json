{
  "name": "@drfed/models",
  "version": "0.2.0",
  "description": "Database models for DrFed.",
  "keywords": [
    "ActivityPub",
    "fediverse",
    "federation",
    "debugger"
  ],
  "author": {
    "name": "DrFed team",
    "url": "https://drfed.org/"
  },
  "maintainers": [
    {
      "name": "ChanHaeng Lee",
      "email": "2chanhaeng@gmail.com",
      "url": "https://chomu.dev/"
    },
    {
      "name": "Hong Minhee",
