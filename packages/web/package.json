{
  "name": "@drfed/web",
  "version": "0.2.0",
  "description": "A SolidStart frontend for DrFed.",
  "keywords": [
    "ActivityPub",
    "fediverse",
    "federation",
    "debugger"
  ],
  "author": {
    "name": "DrFed team",
    "url": "https://drfed.org/"
  },
  "maintainers": [
    {
      "name": "ChanHaeng Lee",
      "email": "2chanhaeng@gmail.com",
      "url": "https://chomu.dev/"
    },
    {
      "name": "Hong Minhee",
      "email": "hong@minhee.org",
      "url": "https://hongminhee.org/"
    },
    {
      "name": "Hyeonseo Kim",
      "email": "dodok8@gmail.com",
      "url": "https://hackers.pub/@gaebalgom"
    },
    {
      "name": "Jiwon Kwon",
      "email": "work@kwonjiwon.org",
      "url": "https://kwonjiwon.org/"
    }
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsdown && vite build",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "@formisch/solid": "1.0.0",
    "@kobalte/core": "^0.13.13",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.6",
    "nitro": "3.0.260610-beta",
    "relay-runtime": "^21.0.1",
    "seroval": "1.6.11",
    "shiki": "4.4.1",
    "solid-js": "^1.9.17",
    "solid-relay": "1.0.0-beta.29",
    "valibot": "1.4.2",
    "vite": "^8.3.3",
    "@types/relay-runtime": "^20.1.1"
  },
  "devDependencies": {
    "eslint-plugin-solid": "^0.14.5",
    "relay-compiler": "^21.0.1",
    "typescript": "catalog:",
    "vite-plugin-cjs-interop": "^4.0.3",
    "vite-plugin-relay-lite": "^0.12.0",
    "tsdown": "catalog:",
    "@types/node": "catalog:"
  },
  "files": [
    "dist/",
    ".output/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/runtime.mjs",
  "types": "dist/runtime.d.mts",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.mts",
      "default": "./dist/bridge.mjs"
    },
    "./request-policy": {
      "types": "./dist/request-policy.d.mts",
      "default": "./dist/request-policy.mjs"
    }
  },
  "tsdown": {
    "entry": [
      "src/runtime.ts",
      "src/bridge.ts",
      "src/request-policy.ts"
    ],
    "dts": {
      "tsconfig": "tsconfig.runtime.json"
    },
    "sourcemap": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fedify-dev/drfed.git",
    "directory": "packages/web"
  }
}
