{
  "name": "@drfed/search-query",
  "version": "0.2.0",
  "description": "Browser-safe search query parser and AST for DrFed.",
  "author": {
    "name": "DrFed team",
    "url": "https://drfed.org/"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
